[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
readme = "README.md"
authors = [
    {name = "{{ author }}"},
]
license = {text = "{{ license }}"}

dependencies = [
    "structlog>=24.0",
    "pydantic-settings>=2.0",
{%- if include_api %}
    "fastapi[standard]>=0.115",
{%- endif %}
{%- if include_cli %}
    "typer>=0.15",
{%- endif %}
]

[project.scripts]
{%- if include_cli %}
dev = "{{ package_name }}.presentation.cli.main:app"
{%- endif %}
check = "scripts.check:main"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "ruff>=0.8",
    "mypy>=1.13",
    "pre-commit>=4.0",
    "import-linter>=2.0",
{%- if include_api %}
    "httpx>=0.28",
{%- endif %}
{%- if include_database %}
    "sqlalchemy>=2.0",
    "asyncpg>=0.30",
    "alembic>=1.14",
    "testcontainers>=4.0",
{%- endif %}
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM", "C90", "PTH", "ASYNC", "RET", "ARG", "RUF", "S"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]  # asserts are the point of tests

[tool.mypy]
strict = true
mypy_path = "src"
explicit_package_bases = true
exclude = '^(\.venv/|\.git/|build/|dist/|.*\.egg-info/)'

[[tool.mypy.overrides]]
module = ["tests.*"]
disallow_untyped_defs = false
{%- if include_database %}

[[tool.mypy.overrides]]
module = ["{{ package_name }}.infrastructure.db.migrations.*"]
disallow_untyped_defs = false
{%- endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.importlinter]
root_package = "{{ package_name }}"
include_external_packages = true

[[tool.importlinter.contracts]]
name = "layers"
type = "layers"
layers = ["presentation", "infrastructure", "application", "domain"]
containers = ["{{ package_name }}"]

[[tool.importlinter.contracts]]
name = "no-frameworks-in-inner-layers"
type = "forbidden"
source_modules = ["{{ package_name }}.domain", "{{ package_name }}.application"]
forbidden_modules = ["sqlalchemy", "fastapi", "pydantic", "typer", "structlog"]
