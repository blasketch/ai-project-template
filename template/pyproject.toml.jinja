[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
readme = "README.md"
authors = [
    {name = "{{ author }}"},
]
license = {text = "{{ license }}"}

dependencies = [
    "structlog>=24.0",
    "pydantic-settings>=2.0",
{%- if include_api %}
    "fastapi[standard]>=0.115",
{%- endif %}
{%- if include_cli %}
    "typer>=0.15",
{%- endif %}
]

[project.scripts]
{%- if include_cli %}
dev = "{{ package_name }}.presentation.cli.main:app"
{%- endif %}
check = "scripts.check:main"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "ruff>=0.8",
    "mypy>=1.13",
    "pre-commit>=4.0",
    "import-linter>=2.0",
{%- if include_api %}
    "httpx>=0.28",
{%- endif %}
{%- if include_database %}
    "sqlalchemy>=2.0",
    "asyncpg>=0.30",
    "alembic>=1.14",
    "testcontainers>=4.0",
{%- endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.importlinter]
root_package = "{{ package_name }}"
include_external_packages = true

[[tool.importlinter.contracts]]
name = "layers"
type = "layers"
layers = ["presentation", "infrastructure", "application", "domain"]
containers = ["{{ package_name }}"]

[[tool.importlinter.contracts]]
name = "no-frameworks-in-inner-layers"
type = "forbidden"
source_modules = ["{{ package_name }}.domain", "{{ package_name }}.application"]
forbidden_modules = ["sqlalchemy", "fastapi", "pydantic", "typer", "structlog"]
