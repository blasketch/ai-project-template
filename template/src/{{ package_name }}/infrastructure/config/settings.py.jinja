"""Typed application settings. Precedence: env vars > .env > defaults.

Fails fast with a domain ConfigError when required values are missing or
invalid at boot.
"""

from functools import lru_cache

from pydantic import Field
from pydantic import ValidationError as PydanticValidationError
from pydantic_settings import BaseSettings, SettingsConfigDict
{% if include_database %}
from pydantic import SecretStr
{% endif %}

from ...domain import ConfigError


class AppSettings(BaseSettings):
    """Core application metadata."""

    model_config = SettingsConfigDict(env_prefix="APP_")

    name: str = "app"
    version: str = "0.1.0"
    debug: bool = False


class LoggingSettings(BaseSettings):
    """Structlog configuration knobs."""

    model_config = SettingsConfigDict(env_prefix="LOG_")

    level: str = "INFO"
    json_format: bool = True
    redaction_patterns: list[str] = ["password", "secret", "token"]

{% if include_database %}
class DatabaseSettings(BaseSettings):
    """Database connection settings gated by include_database."""

    model_config = SettingsConfigDict(env_prefix="DB_")

    url: SecretStr  # required; missing env fails fast at boot
    pool_size: int = 5

{% endif %}
class Settings(BaseSettings):
    """Root settings composed of nested sections."""

    app: AppSettings = Field(default_factory=AppSettings)
    logging: LoggingSettings = Field(default_factory=LoggingSettings)
{% if include_database %}
    database: DatabaseSettings = Field(default_factory=DatabaseSettings)
{% endif %}


def build_settings() -> Settings:
    """Validate sources and return settings; raise ConfigError on failure."""
    try:
        return Settings()
    except PydanticValidationError as exc:
        raise ConfigError(f"Invalid configuration: {exc}") from exc


@lru_cache(maxsize=1)
def get_settings() -> Settings:
    """Cached settings accessor used at boot time."""
    return build_settings()
